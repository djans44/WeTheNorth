# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never carry a real value.

DATABASE_URL=postgresql://user:password@host/dbname

# Direct rather than pooled -- same host with -pooler removed. migrate.py
# prefers this one.
DATABASE_URL_DIRECT=postgresql://user:password@host/dbname

# Signs the session cookie. Anyone who knows it can mint a cookie for any
# owner, admins included, so it is the one value here that matters most.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Only scripts/write_summaries.py uses this, and it is hand-run, so the key
# never needs to reach Render. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
